# ===========================================================================
# NEXT / VERCEL env vars  (Vercel -> Project -> Settings -> Environment Variables)
# ===========================================================================

# Written automatically by `npx convex dev` for local work — never commit .env.local
# NEXT_PUBLIC_CONVEX_URL=https://<your-dev>.convex.cloud
# CONVEX_DEPLOYMENT=dev:dev:beloved-armadillo-465|eyJ2MiI6IjMwY2YzYzg1ZTRjMDQwYzliM2NjMjQyZjg0MmRhZmU5In0=

# Admin UI gate (Next middleware / proxy.ts). Set on Vercel.
#   ADMIN_EMAIL      the admin login (also set the SAME value as a Convex env var
#                    below, for claim-notice emails). Defaults to "admin" if unset.
#   ADMIN_PASSWORD   defaults to "Tool4life123!@#" in code — override on Vercel.
#   ADMIN_AUTH_SECRET  optional; rotate to invalidate all admin sessions.
# ADMIN_EMAIL=you@yourdomain.my
# ADMIN_PASSWORD=change-this-please
# ADMIN_AUTH_SECRET=some-long-random-string


# The ONE var you set by hand on Vercel (Production + Preview).
# Convex dashboard -> your project -> Settings -> switch to the PRODUCTION
# deployment -> Deploy Keys -> Generate Production Deploy Key.  Starts with "prod:".
# A key made on the DEVELOPMENT deployment 401s on Vercel.
# Also make sure CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL are NOT set on Vercel.
# CONVEX_DEPLOY_KEY=prod:your-prod-deployment|ey...


# ===========================================================================
# CONVEX env vars  (these live on the Convex deployment, NOT on Vercel)
#   local:  npx convex env set NAME "value"
#   prod:   npx convex env set NAME "value" --prod   (or the Convex dashboard)
# Emails are sent from Convex actions, so the keys belong here.
# ===========================================================================

# Resend — https://resend.com/api-keys  (unset = emails are logged as "skipped", nothing sent)
#   npx convex env set RESEND_API_KEY re_xxx          # dev
#   npx convex env set RESEND_API_KEY re_xxx --prod   # prod
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender. MUST be a domain you verified in Resend
# (resend.com -> Domains -> Add). The default onboarding@resend.dev ONLY delivers
# to the email address that owns the Resend account — that is why mail to any
# other address silently never arrives.
# EMAILS_FROM=Founders Drive <hello@yourdomain.my>

# Base URL used to build links inside emails (prod: your Vercel domain).
# SITE_URL=https://foundersdrive.my

# Where profile-claim review notices are also sent.
# ADMIN_EMAIL=team@yourdomain.my

# Stripe — paid founder→VC outreach credit packs.
#   npx convex env set STRIPE_SECRET_KEY sk_test_… [--prod]
#   npx convex env set STRIPE_WEBHOOK_SECRET whsec_… [--prod]
# Create a webhook in the Stripe dashboard for the event
# checkout.session.completed pointing at:
#   https://<your-deployment>.convex.site/stripe/webhook
# (Convex "HTTP Actions URL" — the .site domain, shown in the Convex dashboard.)
# SITE_URL must also be set (used for the checkout success/cancel redirects).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
