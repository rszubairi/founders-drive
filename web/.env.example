# ===========================================================================
# NEXT / VERCEL env vars  (Vercel -> Project -> Settings -> Environment Variables)
# ===========================================================================

# Written automatically by `npx convex dev` for local work — never commit .env.local
# NEXT_PUBLIC_CONVEX_URL=https://<your-dev>.convex.cloud
# CONVEX_DEPLOYMENT=dev:dev:beloved-armadillo-465|eyJ2MiI6IjMwY2YzYzg1ZTRjMDQwYzliM2NjMjQyZjg0MmRhZmU5In0=

# The ONE var you set by hand on Vercel (Production + Preview).
# Convex dashboard -> Project Settings -> Production -> Deploy Key.
# vercel.json runs `convex deploy --cmd 'npm run build'`, which injects
# NEXT_PUBLIC_CONVEX_URL into the build for you.
# CONVEX_DEPLOY_KEY=prod:...


# ===========================================================================
# CONVEX env vars  (these live on the Convex deployment, NOT on Vercel)
#   local:  npx convex env set NAME "value"
#   prod:   npx convex env set NAME "value" --prod   (or the Convex dashboard)
# Emails are sent from Convex actions, so the keys belong here.
# ===========================================================================

# Resend — https://resend.com/api-keys  (unset = emails are logged & skipped)
# RESEND_API_KEY=re_...

# Verified sender. Until your domain is verified in Resend, use onboarding@resend.dev.
# EMAILS_FROM=Founders Drive <hello@yourdomain.my>

# Base URL used to build links inside emails (prod: your Vercel domain).
# SITE_URL=https://foundersdrive.my

# Where profile-claim review notices are also sent.
# ADMIN_EMAIL=team@yourdomain.my
